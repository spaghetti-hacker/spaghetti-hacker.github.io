<script>
const PAGE_SIZE = 40;
const TOPIC = {
    "reverse":  "REVERSE",
    "malware":  "MALWARE",
    "vuln":     "VULN",
    "exploit":  "EXPLOIT",
    "firmware": "FIRMWARE",
    "kernel":   "KERNEL",
    "mobile":   "MOBILE"
};
const READ_KEY = "news_re_read";
const SRC_BUTTONS = 14;   /* quante fonti mostrare nel filtro src (le più frequenti, con almeno 2 voci) */

const $ = id => document.getElementById(id);
const esc = s => String(s).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;");
const cmp = (a, b) => a < b ? -1 : a > b ? 1 : 0;
const topicLabel = t => TOPIC[t] || String(t || "n/a").toUpperCase();
const safeUrl = u => /^https?:\/\//i.test(String(u || "")) ? String(u) : null;

let DB = null;
let byId = new Map();
const openIds = new Set();

/* ── letto / non letto (solo nel browser, localStorage) ── */
let READ = new Set();
try{ READ = new Set(JSON.parse(localStorage.getItem(READ_KEY) || "[]")); }catch(e){}
function saveRead(){
    try{ localStorage.setItem(READ_KEY, JSON.stringify([...READ].slice(-3000))); }catch(e){}
}

/* days: N = ultimi N giorni, 0 = tutto l'archivio */
const st = { unread:false, days:30, topic:"all", src:"all", q:"", sort:"date", dir:-1, page:1 };

function cutoffDay(days){
    const d = new Date();
    const t = Date.UTC(d.getFullYear(), d.getMonth(), d.getDate()) - (days - 1) * 86400000;
    return new Date(t).toISOString().slice(0, 10);
}

/* ── filtro + ordinamento ── */
function filtered(){
    const cutoff = st.days === 0 ? "" : cutoffDay(st.days);
    const q = st.q.trim().toLowerCase();
    const rows = DB.items.filter(i =>
        (st.topic === "all" || i.topic === st.topic) &&
        (st.src === "all" || i.source === st.src) &&
        (st.days === 0 || i.published.slice(0, 10) >= cutoff) &&
        (!st.unread || !READ.has(i.id)) &&
        (!q || i.hay.includes(q))
    );
    rows.sort((a, b) => {
        let c;
        if(st.sort === "src")        c = cmp(a.source.toLowerCase(), b.source.toLowerCase()) || cmp(a.published, b.published);
        else if(st.sort === "title") c = cmp(a.title.toLowerCase(), b.title.toLowerCase());
        else                         c = cmp(a.published, b.published) || cmp(a.title, b.title);
        return c * st.dir;
    });
    return rows;
}

/* ── pezzi di HTML ── */
function detailHtml(i){
    let h = `<div class="detail">`;
    if(i.summary) h += `<div>${esc(i.summary)}</div>`;
    if(i.read_min) h += `<div class="dim">lettura: ~${esc(i.read_min)} min</div>`;
    if(i.cves.length){
        h += `<div class="dim">cve:   ` + i.cves.map(c =>
            /^CVE-\d{4}-\d{4,}$/.test(c)
                ? `<a href="https://nvd.nist.gov/vuln/detail/${esc(c)}" target="_blank" rel="noopener noreferrer">${esc(c)}</a>`
                : esc(c)
        ).join(" ") + `</div>`;
    }
    if(i.tags.length) h += `<div class="dim">tags:  ${esc(i.tags.join(", "))}</div>`;
    const srcs = i.sources.filter(s => safeUrl(s.url));
    if(srcs.length){
        h += `<div class="dim">leggi: ` + srcs.map(s =>
            `<a href="${esc(safeUrl(s.url))}" target="_blank" rel="noopener noreferrer">${esc(s.title || safeUrl(s.url))}</a>`
        ).join(" ") + `</div>`;
    }
    return h + `</div>`;
}

function newsHtml(i){
    const open = openIds.has(i.id);
    const flag = `<span class="more"> [${open ? "-" : "+"}]</span>`;
    return esc(i.title) + flag + (open ? detailHtml(i) : "");
}

function rowHtml(i){
    return (
        `<tr${READ.has(i.id) ? ' class="read"' : ""}>` +
        `<td class="c-date">${esc(i.published.slice(0, 10))}</td>` +
        `<td class="c-topic">${esc(topicLabel(i.topic))}</td>` +
        `<td class="c-src" title="${esc(i.source)}">${esc(i.source)}</td>` +
        `<td class="c-news" data-id="${esc(i.id)}">${newsHtml(i)}</td>` +
        `</tr>`
    );
}

function pagerHtml(pages){
    if(pages <= 1) return "";
    const p = st.page, out = [];
    const link = (n, label, on) => `<a href="#" data-p="${n}"${on ? ' class="on"' : ''}>${label}</a>`;
    if(p > 1) out.push(link(p - 1, "&lt; prev"));
    const nums = [...new Set([1, pages, p-2, p-1, p, p+1, p+2])]
        .filter(n => n >= 1 && n <= pages)
        .sort((a, b) => a - b);
    let prev = 0;
    nums.forEach(n => {
        if(n - prev > 1) out.push('<span class="dim">..</span>');
        out.push(link(n, n, n === p));
        prev = n;
    });
    if(p < pages) out.push(link(p + 1, "next &gt;"));
    return out.join(" ");
}

/* ── render ── */
function render(){
    const rows  = filtered();
    const pages = Math.max(1, Math.ceil(rows.length / PAGE_SIZE));
    if(st.page > pages) st.page = pages;
    const slice = rows.slice((st.page - 1) * PAGE_SIZE, st.page * PAGE_SIZE);

    document.querySelectorAll("#filters a[data-f], #srcbar a[data-f]").forEach(a => {
        const f = a.dataset.f, v = a.dataset.v;
        let on = false;
        if(f === "show")       on = (v === "unread") === st.unread;
        else if(f === "days")  on = parseInt(v, 10) === st.days;
        else if(f === "topic") on = v === st.topic;
        else if(f === "src")   on = v === st.src;
        else if(f === "sort")  on = st.sort === v;
        a.classList.toggle("on", on);
        if(f === "sort") a.textContent = a.dataset.label + (on ? (st.dir < 0 ? " v" : " ^") : "");
    });

    const unread = rows.filter(i => !READ.has(i.id)).length;
    $("count").textContent = rows.length
        ? `;${rows.length} report (${unread} da leggere) — pagina ${st.page}/${pages}`
        : ";nessun report";

    if(!slice.length){
        $("list").innerHTML = "";
    } else {
        $("list").innerHTML =
            `<table id="tbl"><thead><tr><th>DATE</th><th>TOPIC</th><th>SRC</th><th>TITLE</th></tr></thead>` +
            `<tbody>${slice.map(rowHtml).join("")}</tbody></table>`;
    }
    $("pager").innerHTML = pagerHtml(pages);
}

/* ── eventi ── */
[$("filters"), $("srcbar")].forEach(el => el.addEventListener("click", e => {
    const a = e.target.closest("a[data-f]");
    if(!a) return;
    e.preventDefault();
    const f = a.dataset.f, v = a.dataset.v;
    if(f === "show")       st.unread = (v === "unread");
    else if(f === "days")  st.days   = parseInt(v, 10);
    else if(f === "topic") st.topic  = v;
    else if(f === "src")   st.src    = v;
    else if(f === "sort"){
        if(st.sort === v) st.dir = -st.dir;
        else { st.sort = v; st.dir = (v === "title" || v === "src") ? 1 : -1; }
    }
    st.page = 1;
    render();
}));

$("pager").addEventListener("click", e => {
    const a = e.target.closest("a[data-p]");
    if(!a) return;
    e.preventDefault();
    st.page = parseInt(a.dataset.p, 10);
    render();
    $("count").scrollIntoView({ block: "start" });
});

$("list").addEventListener("click", e => {
    const tr = e.target.closest("tr");
    if(!tr) return;
    const td = tr.querySelector("td.c-news");
    if(!td) return;
    const id = td.dataset.id;

    /* click su un link di lettura: segna come letto, non aprire/chiudere la riga */
    if(e.target.closest("a")){
        if(!READ.has(id)){ READ.add(id); saveRead(); tr.classList.add("read"); }
        return;
    }
    if(!e.target.closest("td.c-news")) return;
    const item = byId.get(id);
    if(!item) return;
    if(openIds.has(id)) openIds.delete(id); else openIds.add(id);
    td.innerHTML = newsHtml(item);
});

let qTimer = null;
$("prompt-input").addEventListener("input", e => {
    clearTimeout(qTimer);
    qTimer = setTimeout(() => { st.q = e.target.value; st.page = 1; render(); }, 120);
});

/* ── caricamento dati ── */
async function load(){
    try{
        const res = await fetch("news_re_db.json", { cache: "no-store" });
        if(!res.ok) throw new Error("HTTP " + res.status);
        DB = await res.json();
        if(!DB || !Array.isArray(DB.items)) throw new Error("formato non valido");
    }catch(e){
        $("meta").innerHTML = "";
        $("list").innerHTML = `<div class="err">;news_re_db.json non disponibile (${esc(e.message)})</div>`;
        return;
    }

    DB.items = DB.items.filter(i => i && i.id && i.title && /^\d{4}-\d{2}-\d{2}/.test(String(i.published || "")));
    DB.items.forEach(i => {
        i.id        = String(i.id);
        i.title     = String(i.title);
        i.published = String(i.published);
        i.summary   = String(i.summary || "");
        i.topic     = String(i.topic || "");
        i.source    = String(i.source || "n/a");
        i.read_min  = Number.isFinite(i.read_min) ? i.read_min : null;
        i.tags      = Array.isArray(i.tags)    ? i.tags.map(String) : [];
        i.cves      = Array.isArray(i.cves)    ? i.cves.map(String) : [];
        i.sources   = Array.isArray(i.sources) ? i.sources.filter(s => s && typeof s === "object") : [];
        i.hay       = [i.id, i.title, i.summary, i.topic, topicLabel(i.topic), i.source, i.tags.join(" "), i.cves.join(" ")].join(" ").toLowerCase();
        byId.set(i.id, i);
    });

    /* bottoni topic e fonti costruiti dai dati */
    const topics = [...new Set(DB.items.map(i => i.topic).filter(Boolean))].sort();
    $("topiclinks").innerHTML =
        `<a href="#" data-f="topic" data-v="all">ALL</a>` +
        topics.map(t => `<a href="#" data-f="topic" data-v="${esc(t)}">${esc(topicLabel(t))}</a>`).join("");

    const counts = new Map();
    DB.items.forEach(i => counts.set(i.source, (counts.get(i.source) || 0) + 1));
    const srcs = [...counts.entries()]
        .filter(([, n]) => n >= 2)
        .sort((a, b) => b[1] - a[1] || cmp(a[0], b[0]))
        .slice(0, SRC_BUTTONS)
        .map(([s]) => s);
    $("srclinks").innerHTML =
        `<a href="#" data-f="src" data-v="all">ALL</a>` +
        srcs.map(s => `<a href="#" data-f="src" data-v="${esc(s)}">${esc(s)}</a>`).join("");

    const upd = String(DB.updated || "");
    const updMs = Date.parse(upd.endsWith("Z") || /[+-]\d{2}:\d{2}$/.test(upd) ? upd : upd + "Z");
    const ageH = (Date.now() - updMs) / 3600000;
    let meta = `;Report tecnici: reverse engineering, malware analysis, vuln research, low level ;${DB.items.length} voci`;
    if(Number.isFinite(updMs)){
        const updLocal = new Date(updMs).toLocaleString("it-IT", { timeZone: "Europe/Rome", dateStyle: "short", timeStyle: "short" });
        meta += ` ;aggiornato ${esc(updLocal)}`;
        if(ageH > 72) meta += ` <span class="err">| dati vecchi di ${Math.round(ageH)} ore</span>`;
    }
    $("meta").innerHTML = meta;

    render();
    if(!/Mobi|Android/i.test(navigator.userAgent)) $("prompt-input").focus();
}

load();
</script>
